# Digital Risk Protection Platform (DRP) Configuration

# Server
HOST=0.0.0.0
PORT=8000

# Database Configuration (MySQL)
# Default MySQL format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/drp_platform

# Fallback: if MySQL is not reachable, the system automatically uses SQLite: sqlite:///./database/drp.db

# JWT & Security
JWT_SECRET=drp_platform_super_secret_jwt_key_2026_!#
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend API Base URL (leave empty for same-origin proxy)
VITE_API_URL=http://localhost:8000
